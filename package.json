{
  "name": "super-assistant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @super-assistant/daemon --filter @super-assistant/web dev",
    "start": "pnpm --filter @super-assistant/daemon start",
    "build": "pnpm --filter @super-assistant/web build && pnpm --filter @super-assistant/daemon build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "set-version": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@napi-rs/keyring",
      "electron",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
