<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the Developer ID build (used only when the Release workflow has a signing
  certificate). Electron and the bundled Node.js both run V8, which needs JIT and writable executable memory;
  the service loads npm native modules (SQLite, keyring), so library validation is relaxed for them.
  The same file is used for the app and for every binary inside it (entitlementsInherit), including resources/node/node.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
