{
  "name": "@nuonuo/desktop",
  "productName": "Nuonuo",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "description": "Nuonuo desktop app for macOS and Windows: window, tray, notifications, global shortcut, with its own Node.js and service",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "stage": "node ../../scripts/stage-desktop.mjs",
    "dist:mac": "pnpm stage && electron-builder --mac --publish never",
    "dist:win": "pnpm stage && electron-builder --win --publish never",
    "dist:linux": "pnpm stage && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.nuonuo.desktop",
    "productName": "Nuonuo",
    "publish": null,
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "!lib/**/*.test.ts",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": ".stage/daemon",
        "to": "daemon"
      },
      {
        "from": ".stage/node",
        "to": "node"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "entitlements": "signing/entitlements.mac.plist",
      "entitlementsInherit": "signing/entitlements.mac.plist",
      "artifactName": "nuonuo-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "executableName": "nuonuo",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility",
      "artifactName": "nuonuo-${version}-linux-desktop-${arch}.${ext}"
    },
    "artifactName": "nuonuo-${version}-${os}-${arch}.${ext}",
    "dmg": {
      "artifactName": "nuonuo-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "nuonuo-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "nuonuo-${version}-win-${arch}-setup.${ext}",
      "shortcutName": "Nuonuo",
      "guid": "99f09e0f-842f-5875-983d-5a79624d00e0"
    }
  }
}
