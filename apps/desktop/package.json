{
  "name": "@super-assistant/desktop",
  "productName": "Super-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Super-assistant desktop client: window, tray, notifications, global shortcut",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.super-assistant.desktop",
    "productName": "Super-assistant",
    "files": ["main.cjs", "preload.cjs", "lib/**"],
    "extraResources": [{ "from": "../daemon/dist", "to": "daemon" }],
    "mac": { "category": "public.app-category.productivity", "target": ["dmg", "zip"] },
    "linux": { "target": ["AppImage"], "category": "Utility" }
  }
}
