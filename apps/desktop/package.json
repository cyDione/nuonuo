{
  "name": "@super-assistant/desktop",
  "productName": "Super-assistant",
  "version": "0.1.7",
  "private": true,
  "description": "Super-assistant desktop client: window, tray, notifications, global shortcut",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "stage": "bash ../../scripts/stage-daemon.sh",
    "dist:mac": "pnpm stage && electron-builder --mac",
    "dist:linux": "pnpm stage && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.super-assistant.desktop",
    "productName": "Super-assistant",
    "publish": null,
    "afterPack": "scripts/after-pack.cjs",
    "files": ["main.cjs", "preload.cjs", "lib/**"],
    "extraResources": [{ "from": ".stage/daemon", "to": "daemon" }],
    "mac": { "category": "public.app-category.productivity", "target": ["dmg", "zip"] },
    "linux": { "executableName": "super-assistant", "target": ["AppImage", "tar.gz"], "category": "Utility", "artifactName": "${productName}-${version}-linux-${arch}.${ext}" }
  }
}
